{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VMS Deploy Tools",
  "version": "0.1.0",
  "identifier": "com.vms.deploytool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VMS Deployment Tools",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "execute": true,
      "sidecar": false
    },
    "fs": {
      "all": true,
      "scope": ["$HOME/**", "$APPDATA/**", "$APPLOCALDATA/**"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
